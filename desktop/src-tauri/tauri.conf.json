{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Remote Pair",
  "version": "1.0.0",
  "identifier": "dev.jeanribeiro.simpleremotepair",
  "build": {
    "beforeDevCommand": "npm --prefix .. run build:client",
    "beforeBuildCommand": "npm --prefix .. run build:client",
    "frontendDist": "../../dist/client"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jean Ribeiro",
    "shortDescription": "Self-hosted screen sharing with remote mouse & keyboard",
    "longDescription": "Pair programming for trusted networks: stream your screen over WebRTC and hand mouse & keyboard to guests who join from any browser. Sessions are gated by one-time codes; no cloud, no accounts."
  }
}
